# BusinessOS environment template (no real secrets).
# This file is not loaded automatically.
# Local secrets belong in deploy/env/.env.dev, .env.staging, and .env.prod-local.
# Create those files with:
#   powershell -NoProfile -ExecutionPolicy Bypass -File .\deploy\scripts\setup-local.ps1
#
# See deploy/README.md for development, staging, and production-simulation commands.

# ── ASP.NET Core ────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7157;http://localhost:5157

# ── Database (SQL Server) ───────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Server=localhost\\SQLEXPRESS;Database=BusinessOS;Integrated Security=True;TrustServerCertificate=True;Encrypt=True;Connect Timeout=60
Database__ApplyMigrationsOnStartup=false

# ── JWT / Auth ──────────────────────────────────────────────────────────────
Jwt__Issuer=BusinessOS
Jwt__Audience=BusinessOSUsers
Jwt__Key=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpiryMinutes=15
Auth__RefreshTokenDays=14
Auth__RefreshReuseGraceSeconds=15
App__FrontendBaseUrl=https://app.example.com
App__PasswordResetTokenHours=24

# ── CORS / Hosts ────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=https://app.example.com
AllowedHosts=api.example.com

# ── OpenAI / Navla AI ───────────────────────────────────────────────────────
# Leave empty to disable paid OpenAI calls. Never commit a real key.
Ai__OpenAiApiKey=
Ai__OpenAiModel=gpt-4o-mini
Ai__OpenAiEmbeddingModel=text-embedding-3-small
# Chat model: gpt-4o-mini. Embeddings: text-embedding-3-small. Speech: gpt-4o-mini-tts.

# ── Qdrant vector store ─────────────────────────────────────────────────────
Qdrant__Enabled=true
Qdrant__Host=localhost
Qdrant__Port=6334
Qdrant__Collection=businessos_knowledge
Qdrant__ApiKey=

# ── Email ───────────────────────────────────────────────────────────────────
Email__Provider=smtp
Email__FromAddress=noreply@example.com
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=

# ── Stripe billing ──────────────────────────────────────────────────────────
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=
Stripe__SuccessUrl=https://app.example.com/billing?success=true
Stripe__CancelUrl=https://app.example.com/pricing?cancelled=true
Stripe__BillingPortalReturnUrl=https://app.example.com/billing

# ── Google OAuth (optional) ─────────────────────────────────────────────────
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

# ── Logging ─────────────────────────────────────────────────────────────────
Serilog__MinimumLevel__Default=Information
Logging__Performance__HttpWarningThresholdMs=3000
Logging__Performance__SlowQueryThresholdMs=500

# ── File storage ────────────────────────────────────────────────────────────
Storage__RootPath=./App_Data/files
Storage__MaxUploadBytes=5242880

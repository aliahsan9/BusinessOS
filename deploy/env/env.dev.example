# Containerized development (workflow B). Copy is created by setup-local.ps1.
# SQL_MODE=container uses the optional SQL Server container and database BusinessOS_DockerDev.
# It does not use the existing Windows database named BusinessOS.
# SQL_MODE=host uses SQL Server Express after TCP is enabled. Set:
#   SQL_SERVER=host.docker.internal,1433
#   SQL_USER=businessos_dev
#   SQL_PASSWORD=<the login password>
#   SQL_DATABASE=BusinessOS_DockerDev

BUSINESSOS_ENVIRONMENT=dev
COMPOSE_PROJECT_NAME=businessos-dev
IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Development
ALLOWED_HOSTS=localhost;127.0.0.1
SQL_MODE=container
SQL_SERVER=sqlserver,1433
SQL_DATABASE=BusinessOS_DockerDev
SQL_USER=sa
SQL_PASSWORD=CHANGE_ME_SQL
SQL_SA_PASSWORD=CHANGE_ME_SQL
SQL_HOST_PORT=14331
SQL_IP=172.30.10.40
DOCKER_SUBNET=172.30.10.0/24
API_IP=172.30.10.10
WEB_IP=172.30.10.20
QDRANT_IP=172.30.10.30
JWT_KEY=CHANGE_ME_JWT
FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGIN_0=http://localhost:4200
CORS_ORIGIN_1=http://127.0.0.1:4200
QDRANT_COLLECTION=businessos_knowledge_dev
QDRANT_API_KEY=
VECTOR_BACKFILL_ON_STARTUP=true
STRIPE_SUCCESS_URL=http://localhost:4200/billing?success=true
STRIPE_CANCEL_URL=http://localhost:4200/pricing?cancelled=true
STRIPE_PORTAL_URL=http://localhost:4200/billing
JAZZCASH_RETURN_URL=http://localhost:4200/billing?provider=jazzcash
EASYPAISA_RETURN_URL=http://localhost:4200/billing?provider=easypaisa
AI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=

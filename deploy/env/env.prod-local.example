# Local production simulation. Isolated from development and staging data.
# This is not a hosted production environment.

BUSINESSOS_ENVIRONMENT=prod-local
COMPOSE_PROJECT_NAME=businessos-prodlocal
IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_HOSTS=localhost;127.0.0.1
SQL_MODE=container
SQL_SERVER=sqlserver,1433
SQL_DATABASE=BusinessOS_ProdLocal
SQL_USER=sa
SQL_PASSWORD=CHANGE_ME_SQL
SQL_SA_PASSWORD=CHANGE_ME_SQL
SQL_HOST_PORT=14333
SQL_IP=172.30.30.40
DOCKER_SUBNET=172.30.30.0/24
API_IP=172.30.30.10
WEB_IP=172.30.30.20
QDRANT_IP=172.30.30.30
JWT_KEY=CHANGE_ME_JWT
FRONTEND_BASE_URL=https://localhost:4202
CORS_ORIGIN_0=https://localhost:4202
CORS_ORIGIN_1=https://127.0.0.1:4202
QDRANT_COLLECTION=businessos_knowledge_prodlocal
QDRANT_API_KEY=
VECTOR_BACKFILL_ON_STARTUP=false
STRIPE_SUCCESS_URL=https://localhost:4202/billing?success=true
STRIPE_CANCEL_URL=https://localhost:4202/pricing?cancelled=true
STRIPE_PORTAL_URL=https://localhost:4202/billing

# Local staging. Isolated from the Windows database named BusinessOS.
# Replace nothing by hand if you use setup-local.ps1. That script fills the secrets once.

BUSINESSOS_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=businessos-staging
IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Staging
ALLOWED_HOSTS=localhost;127.0.0.1
SQL_MODE=container
SQL_SERVER=sqlserver,1433
SQL_DATABASE=BusinessOS_Staging
SQL_USER=sa
SQL_PASSWORD=CHANGE_ME_SQL
SQL_SA_PASSWORD=CHANGE_ME_SQL
SQL_HOST_PORT=14332
SQL_IP=172.30.20.40
DOCKER_SUBNET=172.30.20.0/24
API_IP=172.30.20.10
WEB_IP=172.30.20.20
QDRANT_IP=172.30.20.30
JWT_KEY=CHANGE_ME_JWT
FRONTEND_BASE_URL=https://localhost:4201
CORS_ORIGIN_0=https://localhost:4201
CORS_ORIGIN_1=https://127.0.0.1:4201
QDRANT_COLLECTION=businessos_knowledge_staging
QDRANT_API_KEY=
VECTOR_BACKFILL_ON_STARTUP=false
STRIPE_SUCCESS_URL=https://localhost:4201/billing?success=true
STRIPE_CANCEL_URL=https://localhost:4201/pricing?cancelled=true
STRIPE_PORTAL_URL=https://localhost:4201/billing
JAZZCASH_RETURN_URL=https://localhost:4201/billing?provider=jazzcash
EASYPAISA_RETURN_URL=https://localhost:4201/billing?provider=easypaisa
AI_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
